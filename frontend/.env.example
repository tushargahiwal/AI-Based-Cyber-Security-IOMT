# Where the API lives.
#
# Development: leave as /api/v1 — vite.config.js proxies it to localhost:8000.
# Docker:      leave as /api/v1 — nginx proxies it to the backend container.
# Vercel:      set BOTH of these to your backend's public URL, because the
#              frontend and backend are then on different hosts and there is no
#              proxy in between.
VITE_API_BASE_URL=/api/v1

# The live monitor's WebSocket. Leave unset for same-origin deployments; the
# hook derives ws://host/api/v1/ws itself. On Vercel it must be set explicitly,
# and it must be wss:// — a page served over HTTPS cannot open a ws:// socket.
# VITE_WS_URL=wss://your-backend.example.com/api/v1/ws
