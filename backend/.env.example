APP_NAME=IoMT IDS Backend
ENV=development
DEBUG=true

DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/iomt_ids?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0

JWT_SECRET_KEY=change-me-to-a-random-secret

# Required to create the FIRST admin when ENV is not "development". Without it,
# "the table has no admin yet, so this account becomes one" is a race anyone who
# finds a public deployment can win. Send it as an X-Bootstrap-Token header on
# POST /auth/register. It stops working the moment a real admin exists.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BOOTSTRAP_TOKEN=

# Browser origins allowed to call this API. Only needed when the frontend is
# served from a different host — a Vercel deployment calling this backend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
